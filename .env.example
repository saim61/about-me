# Copy to .env (gitignored) and fill in. Every setting has the ABOUT_RAG_ prefix.

# Gemini API key for generation (Phase 5).
ABOUT_RAG_LLM_API_KEY=

# Postgres + pgvector. The default matches docker-compose.yml; set it for production.
# ABOUT_RAG_DATABASE_URL=postgresql://about_rag:about_rag@localhost:5433/about_rag

# Optional overrides.
# ABOUT_RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# ABOUT_RAG_TOP_K=3
# ABOUT_RAG_LOG_LEVEL=INFO
